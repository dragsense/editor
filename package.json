{
  "name": "autocode-editor",
  "version": "1.0.0",
  "private": true,
  "main": "public/electron.js",
  "description": "autocode web editor",
  "author": {
    "name": "Autocode",
    "email": "support@dragsense.com"
  },
  "homepage": "./",
  "dependencies": {
    "electron": "^25.9.8",
    "electron-store": "^8.1.0",
    "expr-eval": "^2.0.2"
  },
  "scripts": {
    "build": "react-scripts build",
    "electron:start": "electron .",
    "electron:package:mac": "npm run build && electron-builder -m -c.extraMetadata.main=build/electron.js",
    "electron:package:win": "npm run build && electron-builder -w -c.extraMetadata.main=build/electron.js",
    "electron:package:linux": "electron-builder -l -c.extraMetadata.main=build/electron.js",
    "electron:package:all": "npm run build && electron-builder -mwl -c.extraMetadata.main=build/electron.js",
    "start": "set PORT=3002 && react-scripts start",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "build": {
    "appId": "com.app.autocode",
    "productName": "Autocode Editor",
    "files": [
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Autocode Protocol",
        "schemes": [
          "autocode-editor"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/favicon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/favicon.ico"
    },
    "linux": {
      "target": "deb",
      "icon": "build/favicon.png"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 1 electron version",
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 electron version",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@ant-design/icons": "^5.1.4",
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "alloyeditor": "^2.14.9",
    "antd": "^5.7.3",
    "axios": "^1.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.6.3",
    "electron-is-dev": "^2.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "electronmon": "^2.0.2",
    "fuse.js": "^6.6.2",
    "install": "^0.13.0",
    "nanoid": "^4.0.2",
    "nodemon": "^3.0.1",
    "npm": "^9.8.1",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.14.2",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-transition-group": "^4.4.5",
    "react-window": "^1.8.9",
    "realm": "^11.10.1",
    "wait-on": "^7.0.1",
    "web-vitals": "^2.1.4",
    "webpack-node-externals": "^3.0.0"
  }
}
